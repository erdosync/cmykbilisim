---
import Base from '../layouts/Base.astro';
import ModelSearch from '../components/ModelSearch.astro';
---

<Base title="Sayfa bulunamadı" noindex>
  <div class="wrap nf">
    <h1>Bu sayfa bulunamadı</h1>
    <p>Adres değişmiş ya da yanlış yazılmış olabilir. Aradığınız ürünü yazıcı modeliyle bulabilirsiniz.</p>
    <ModelSearch size="hero" />
    <p class="back"><a href="/">Ana sayfaya dön</a></p>
  </div>
</Base>

<style>
  .nf { padding-block: 80px; max-width: 760px; }
  .nf > p { margin: 16px 0 32px; color: var(--ink-2); font-size: 19px; }
  .nf .back { margin-top: 32px; }
</style>
