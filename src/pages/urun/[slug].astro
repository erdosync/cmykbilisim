---
import Base from '../../layouts/Base.astro';
import ProductVisual from '../../components/ProductVisual.astro';
import ProductCard from '../../components/ProductCard.astro';
import Icon from '../../components/Icon.astro';
import {
  PRODUCTS, COLORS, TYPES, brandName, categoryName, modelCount, relatedProducts, type Product,
} from '../../lib/products';
import { brandLogo, productPhoto } from '../../lib/brandLogo';
import { SITE, whatsappLink } from '../../data/site';

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}
const { product: p } = Astro.props as { product: Product };

const brand = brandName(p.brand);
const logo = brandLogo(p.brand);
const color = p.color ? COLORS[p.color] : null;
const models = modelCount(p);
const related = relatedProducts(p);
const photo = productPhoto(p.slug);

const facts: [string, string][] = [
  ['Marka', brand],
  ['Ürün kodu', p.code],
  ['Ürün grubu', categoryName(p.category)],
  ...(p.type ? [['Tür', TYPES[p.type]] as [string, string]] : []),
  ...(color ? [['Renk', color.name] as [string, string]] : []),
  ...(p.capacity ? [['Sayfa kapasitesi', p.capacity] as [string, string]] : []),
  ...Object.entries(p.specs),
];

const ask = `Merhaba, ${p.name} (${p.code}) için fiyat ve stok bilgisi alabilir miyim?`;
const mail = `mailto:${SITE.email}?subject=${encodeURIComponent(`${p.name} hakkında bilgi`)}&body=${encodeURIComponent(ask)}`;

const description = `${p.name} (${p.code}). ${p.description}${models ? ` ${models} yazıcı modeliyle uyumlu.` : ''} Fiyat ve stok için bize ulaşın.`;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  sku: p.code,
  mpn: p.specs['Üretici Parça No'] ?? p.code,
  brand: { '@type': 'Brand', name: brand },
  category: categoryName(p.category),
  description: p.description,
  ...(photo ? { image: new URL(photo, Astro.site).toString() } : {}),
};
---

<Base title={p.name} description={description} waMessage={ask}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="wrap">
    <ol class="crumbs top">
      <li><a href="/">Ana sayfa</a></li>
      <li><a href={`/kategori/${p.category}`}>{categoryName(p.category)}</a></li>
      <li><a href={`/marka/${p.brand}`}>{brand}</a></li>
      <li aria-current="page">{p.code}</li>
    </ol>

    <article class="product">
      <div class="art-col">
        <div class="art"><ProductVisual product={p} eager /></div>
        {!photo && <p class="art-note">Temsili görsel</p>}
      </div>

      <div class="info">
        <a class="brand" href={`/marka/${p.brand}`}>
          {logo ? <img src={logo} alt={brand} /> : brand}
        </a>
        <h1>{p.name}</h1>
        <p class="desc">{p.description}</p>

        <dl class="facts">
          {facts.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
        </dl>

        <div class="ask">
          <p class="ask-title">Fiyat ve stok bilgisi için bize yazın</p>
          <div class="ask-actions">
            <a class="btn btn-wa" href={whatsappLink(ask)} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp'tan sorun</a>
            <a class="btn btn-line" href={SITE.phoneHref}><Icon name="phone" />{SITE.phone}</a>
            <a class="btn btn-line" href={mail}><Icon name="mail" />E-posta</a>
          </div>
        </div>
      </div>
    </article>

    {models > 0 && (
      <section class="compat" aria-labelledby="compat-h">
        <h2 id="compat-h">Uyumlu yazıcılar</h2>
        <p class="compat-sub">{p.code}, aşağıdaki {models} {brand} yazıcı modelinde kullanılır.</p>
        <div class="series">
          {p.compatible.map((g) => (
            <div class="serie">
              <h3>{g.series} serisi</h3>
              <ul>{g.models.map((m) => <li>{m}</li>)}</ul>
            </div>
          ))}
        </div>
        <p class="compat-help">
          Yazıcınız listede yok mu?{' '}
          <a href={whatsappLink(`Merhaba, yazıcım için uygun toneri öğrenmek istiyorum. Yazıcı modelim: `)} target="_blank" rel="noopener">Modelinizi yazın</a>, uygun ürünü bulalım.
        </p>
      </section>
    )}

    {related.length > 0 && (
      <section class="related" aria-labelledby="rel-h">
        <h2 id="rel-h">Benzer ürünler</h2>
        <div class="grid-products">{related.map((r) => <ProductCard product={r} />)}</div>
      </section>
    )}
  </div>
</Base>

<style>
  .crumbs.top { padding-top: 28px; margin-bottom: 24px; }

  .product { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
  .art-col { position: sticky; top: 100px; }
  .art { background: var(--paper-2); border-radius: 14px; padding: clamp(24px, 5vw, 56px); }
  .art-note { margin-top: 8px; font-size: 14px; color: var(--ink-3); }

  .brand { display: inline-flex; align-items: center; min-height: 32px; font-family: var(--font-display); font-weight: 700; color: var(--ink-2); text-decoration: none; }
  .brand img { height: 30px; width: 130px; object-fit: contain; object-position: left center; }
  .info h1 { margin-top: 14px; font-size: clamp(28px, 3.6vw, 40px); }
  .desc { margin-top: 14px; color: var(--ink-2); font-size: 19px; max-width: 56ch; }

  .facts { margin: 28px 0 0; border-top: 1px solid var(--rule); }
  .facts div { display: grid; grid-template-columns: 180px 1fr; gap: 16px; padding: 11px 0; border-bottom: 1px solid var(--rule); }
  .facts dt { color: var(--ink-3); }
  .facts dd { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; }

  .ask { margin-top: 28px; padding: 22px; border-radius: 14px; background: var(--paper-2); }
  .ask-title { font-family: var(--font-display); font-weight: 700; font-size: 18px; }
  .ask-actions { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 10px; }

  .compat { margin-top: clamp(48px, 7vw, 80px); padding-top: 40px; border-top: 1px solid var(--rule); }
  .compat-sub { margin-top: 8px; color: var(--ink-2); }
  .series { margin-top: 24px; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 24px 40px; }
  .serie h3 { font-size: 16px; color: var(--ink-3); font-weight: 700; }
  .serie ul { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .serie li {
    padding: 5px 12px; border: 1px solid var(--rule); border-radius: 6px;
    font-weight: 600; font-size: 16px; font-variant-numeric: tabular-nums;
  }
  .compat-help { margin-top: 28px; color: var(--ink-2); }

  .related { margin-top: clamp(48px, 7vw, 80px); }
  .related h2 { margin-bottom: 24px; }

  @media (max-width: 860px) {
    .product { grid-template-columns: 1fr; }
    .art-col { position: static; }
    .art { padding: 20px 40px; }
    .facts div { grid-template-columns: 140px 1fr; }
  }
</style>
